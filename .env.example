# Copy to .env and fill in values before running `podman compose up -d`.
# See README.md for the full walkthrough.

# ── S3 (SeaweedFS, local) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=any
AWS_SECRET_ACCESS_KEY=any
AWS_REGION=us-east-1
BUCKET=acme-quickstart

# ── URLs ─────────────────────────────────────────────────────────────────
# "server" must resolve to 127.0.0.1 on your machine — see README.md's
# "One-time host setup" step.
BASE_URL=http://server:3000
ISSUER=http://server:4000
RESOURCE_SERVER_URL=http://server:3000
TRUSTED_ISSUERS=http://server:4000

# ── acme-idp ─────────────────────────────────────────────────────────────
# Generate with:
#   podman run --rm ghcr.io/jeremycaine/acme-idp:latest node dist/keygen.js
OIDC_JWKS=
COOKIE_SECRETS=dev-secret-change-in-production
# Leave blank so you create your own account instead of a demo identity.
# Set to "true" for a quick smoke test with pre-seeded alice/bob accounts.
SEED_TEST_ACCOUNTS=

# ── Set this after creating your account — see README.md step 5 ──────────
SERVER_OWNER_WEBID=
